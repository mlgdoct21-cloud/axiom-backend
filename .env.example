# ============================================================================
# AXIOM Backend — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to git.
# ============================================================================

# ── Environment ────────────────────────────────────────────────────────────────
# "production" veya "development". Production'da SECRET_KEY ve BOT_INTERNAL_SECRET
# zorunludur (yoksa uygulama RuntimeError ile durur).
ENVIRONMENT=development

# ── Database ───────────────────────────────────────────────────────────────────
# Production: postgresql://user:password@host:port/dbname
# Development fallback: SQLite (otomatik)
DATABASE_URL=sqlite:///axiom.db

# Connection pool (sadece PostgreSQL için anlamlı)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Authentication & Security ──────────────────────────────────────────────────
# JWT signing key — minimum 32 karakter zorunlu.
# Üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_random_48_char_secret_min_32_chars

# Telegram bot ile backend arasındaki internal auth secret.
# /api/v1/auth/login endpoint'i bu header olmadan çalışmaz.
# Üret: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_INTERNAL_SECRET=replace_with_random_32_char_secret

# ── CORS ───────────────────────────────────────────────────────────────────────
# Virgülle ayrılmış izin verilen frontend origin'leri.
# Production'da SADECE gerçek domain'ler — asla "*" kullanma.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── External APIs ──────────────────────────────────────────────────────────────
# Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model konfigürasyonu (opsiyonel — defaults work)
AXIOM_GEMINI_PRIMARY=gemini-2.5-flash-lite
AXIOM_GEMINI_FALLBACK=gemini-2.0-flash
AXIOM_MODEL_COOLDOWN_SEC=900

# Telegram Bot Token (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Dashboard URL (bot tarafından insider-report endpoint'i için kullanılır)
DASHBOARD_URL=https://axiom-dashboard.vercel.app

# ── Bot Rate Limiting ──────────────────────────────────────────────────────────
# Pahalı komutlar (/haber, /report) için kullanıcı başına cooldown
BOT_HEAVY_CMD_COOLDOWN_SEC=30
# Hafif komutlar (/takip vb.) için kullanıcı başına cooldown
BOT_LIGHT_CMD_COOLDOWN_SEC=3

# ── BIST (Borsa Istanbul) ──────────────────────────────────────────────────────
# Desteklenen BIST sembolleri (virgülle ayrılmış). Bu listedeki semboller
# yfinance üzerinden .IS suffix ile çekilir (örn: ASELS -> ASELS.IS).
BIST_SYMBOLS=ASELS,GARAN,KCHOL,THYAO,AKBNK,BIMAS,EREGL,TAVHL,PETKM,SASA,SISE,TCELL,TUPRS,FROTO,YKBNK,HALKB,ISCTR,VAKBN,ARCLK,KOZAL

# Veri sağlayıcısı: "yfinance" (Phase 1, free, ~15dk delay)
# veya "twelvedata" (Phase 2, $29/mo, real-time — implementasyon bekliyor)
BIST_PROVIDER=yfinance

# BIST fiyat cache süresi (saniye)
BIST_CACHE_TTL_SECONDS=60

# ── Server ─────────────────────────────────────────────────────────────────────
# Railway PORT env var'ı otomatik set eder; lokal için fallback
API_PORT=8000
